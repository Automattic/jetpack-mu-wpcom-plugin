{
	"name": "automattic/jetpack-podcast",
	"description": "Jetpack Podcast functionality (Simple and Atomic only).",
	"type": "jetpack-library",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.2",
		"automattic/jetpack-assets": "^4.3.37-alpha",
		"automattic/jetpack-blocks": "^3.3.2-alpha",
		"automattic/jetpack-connection": "^8.3.6-alpha",
		"automattic/jetpack-plans": "^0.11.6-alpha",
		"automattic/jetpack-status": "^6.1.4-alpha",
		"automattic/jetpack-wp-build-polyfills": "^0.1.9-alpha"
	},
	"require-dev": {
		"yoast/phpunit-polyfills": "^4.0.0",
		"automattic/jetpack-test-environment": "@dev",
		"automattic/phpunit-select-config": "^1.0.6-alpha"
	},
	"suggest": {
		"automattic/jetpack-autoloader": "Allow for better interoperability with other plugins that use this package."
	},
	"autoload": {
		"classmap": [
			"src/"
		]
	},
	"scripts": {
		"build-development": "pnpm run build",
		"build-production": "pnpm run build-production",
		"watch": [
			"Composer\\Config::disableProcessTimeout",
			"pnpm run watch"
		],
		"phpunit": [
			"phpunit-select-config phpunit.#.xml.dist --colors=always"
		],
		"test-php": [
			"@composer phpunit"
		]
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"extra": {
		"autorelease": true,
		"autotagger": true,
		"mirror-repo": "Automattic/jetpack-podcast",
		"branch-alias": {
			"dev-trunk": "1.0.x-dev"
		},
		"textdomain": "jetpack-podcast",
		"version-constants": {
			"::PACKAGE_VERSION": "src/class-podcast.php"
		},
		"changelogger": {
			"link-template": "https://github.com/Automattic/jetpack-podcast/compare/v${old}...v${new}"
		}
	},
	"config": {
		"allow-plugins": {
			"roots/wordpress-core-installer": true
		}
	}
}
